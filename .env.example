# Anthropic API key (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# Optional: model for reviewing jobs (default claude-haiku-4-5)
AI_MODEL=claude-haiku-4-5

# Gmail account that sends applications and the report
GMAIL_USER=you@gmail.com
# 16-character app password (myaccount.google.com/apppasswords; needs 2-step verification)
GMAIL_APP_PASSWORD=

# Alternative to the app password: Gmail OAuth2 (see README). Leave empty to use the app password.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# true = application emails go to you (marked as drafts), never to employers
DRY_RUN=true
# Where the daily report goes (defaults to GMAIL_USER)
REPORT_TO=

# Town on jobs.ams.at to search around (default Salzburg), e.g. Wien, Graz, Linz, Innsbruck
CITY=Salzburg

# Optional tuning
# CV_PATH=assets/cv.pdf
# MAX_APPLICATIONS_PER_RUN=15
# SEND_DELAY_SECONDS=30
# MAX_AGE_DAYS=15
# RADIUS_KM=25
# MAX_NEW_JOBS_PER_RUN=500
# REVIEW_CONCURRENCY=5
