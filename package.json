{
  "name": "ams-bot",
  "version": "1.0.0",
  "description": "Daily AMS (jobs.ams.at) student job finder and email applier for Salzburg",
  "main": "src/main.ts",
  "scripts": {
    "start": "tsx src/main.ts",
    "fetch": "tsx src/main.ts --fetch-only",
    "dry": "tsx src/main.ts --dry",
    "send": "tsx src/main.ts --send-only",
    "reset": "tsx src/reset.ts",
    "typecheck": "tsc --noEmit",
    "schedule": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/schedule-windows.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "nodemailer": "^10.1.7",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.7"
  }
}
